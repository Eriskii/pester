# Discord (token required). The bot answers DMs; PESTER_DISCORD_USER locks
# it to one user's DMs (unset accepts any DM and logs the sender's id).
PESTER_DISCORD_TOKEN=your-bot-token
#PESTER_DISCORD_USER=123456789012345678

# Aliases: user id → the name the agent sees instead of the Discord
# username.
#PESTER_USER_ALIASES=123456789012345678:Julia,876543210987654321:Eris

# Provider — defaults target the ChatGPT Codex backend through the Codex
# CLI's auth file, so a machine with a logged-in Codex CLI needs none of
# these. For the platform API: base url https://api.openai.com/v1 and a
# plain sk-... key.
#PESTER_MODEL=gpt-5.6-luna
#PESTER_BASE_URL=https://chatgpt.com/backend-api/codex
#PESTER_API_KEY=codex-auth-file:~/.codex/auth.json
#PESTER_TIMEOUT_SECONDS=600
#PESTER_MAX_OUTPUT_TOKENS=

# Reasoning effort per turn: none|minimal|low|medium|high|xhigh
#PESTER_REASONING=medium

# Data directory (created if missing; system/ prompts + files/ jail)
#PESTER_DATA_DIR=data

# Status web UI bind address
#PESTER_WEB_ADDR=127.0.0.1:8130

# Compaction: fold the conversation into a rolling summary after this many
# minutes of silence (past the prompt-cache TTL it's free), and immediately
# after any turn whose prompt crossed this token budget.
#PESTER_IDLE_COMPACT_MINS=50
#PESTER_COMPACT_TOKENS=100000
